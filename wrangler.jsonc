{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "sophie2tool",
  "compatibility_date": "2026-07-26",
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "./dist",
    // Client-side routes (/recipe/<slug>) have no file in dist: serve index.html
    // so deep links and reloads work instead of an empty 404.
    "not_found_handling": "single-page-application",
  },
  "compatibility_flags": ["nodejs_compat"],
}
